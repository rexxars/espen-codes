---
interface Props {
  node: {
    code: string
    filename?: string
    language?: string
  }
}

const {node} = Astro.props
---

<figure class="code-block">
  {node.filename && <figcaption>{node.filename}</figcaption>}
  <pre><code class={`language-${node.language ?? 'text'}`}>{node.code}</code></pre>
</figure>

<style>
  .code-block {
    margin: 2rem 0;
  }

  figcaption {
    border-radius: 0.45rem 0.45rem 0 0;
    background: #2b2b2b;
    color: #ddd;
    font:
      0.8rem/1.4 ui-monospace,
      monospace;
    padding: 0.45rem 0.75rem;
  }

  pre {
    background: #151515;
    border-radius: 0.45rem;
    color: #f5f5f5;
    margin: 0;
    overflow-x: auto;
    padding: 1rem;
  }

  figcaption + pre {
    border-radius: 0 0 0.45rem 0.45rem;
  }
</style>
